# Origin of the ticketing site, no trailing slash, e.g. https://in.<site>.com
SITE_BASE_URL=

# Telegram: create a bot with @BotFather, then get your chat id
# (message the bot, open https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

REDIS_URL=redis://127.0.0.1:6379

# Persistent browser profile (cookies survive restarts)
BROWSER_PROFILE_DIR=.browser-profile
# Visible browser is far less likely to be challenged; set true to hide it
HEADLESS=false
# Optional: "chrome" to use installed Google Chrome instead of bundled Chromium
BROWSER_CHANNEL=

# Optional: alternate config file
# CONFIG_PATH=config.json

# How to reach the site: "browser" (Playwright, default) or "http"
# (plain HTTP with a browser fingerprint; no Chromium needed)
# SOURCE=browser
# Optional (http source): seat-layout key, only if the site changes it
# SEAT_LAYOUT_KEY=
