{
  "name": "fdfs-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram alerts for new shows at Prasads Multiplex",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "setup:browser": "playwright install chromium",
    "telegram:test": "tsx src/scripts/telegram-test.ts",
    "dashboard": "tsx src/web/server.ts",
    "start:dashboard": "node dist/web/server.js",
    "capture-layouts": "tsc -p tsconfig.json && node dist/scripts/capture-layouts.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
